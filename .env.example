# ==============================================================================
# LEADPULSE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER-SIDE SECRETS (Required on Node.js Backend Server)
# NEVER bundle these into frontend code or commit real values to Git.
# ------------------------------------------------------------------------------

# Gemini API Key (Required for server-side search grounding & cold outreach)
GEMINI_API_KEY=""

# Google Maps Platform Key (Required for Google Places API (New) discovery)
GOOGLE_MAPS_API_KEY=""

# Allowed CORS Origins (Required in production for decoupled frontend)
# Comma-separated list of origins, e.g. "https://<username>.github.io,https://leadpulse.mydomain.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Server Port (Defaults to 3000)
PORT="3000"

# Node Environment
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT-SIDE CONFIGURATION (Build-time / Public)
# ------------------------------------------------------------------------------

# Public Backend API URL for GitHub Pages / decoupled frontend deployments.
# Point this to your deployed backend (e.g. "https://api.yourdomain.com").
# Leave empty for same-origin / full-stack single-server deployments.
VITE_API_BASE_URL=""

# Base Path for GitHub Pages subfolder (e.g. "/leadpulse-app/" or "./")
# Defaults to "./" relative path if left blank.
VITE_BASE_PATH="./"


